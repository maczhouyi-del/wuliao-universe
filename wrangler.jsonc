{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wuliao-universe",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "wuliao.tianyuanai.top", "custom_domain": true }],
  "workers_dev": false,
}
